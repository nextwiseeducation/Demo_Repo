# Copy to .env and fill in real values. Never commit .env.
#
# Every variable below is read in config/settings/base.py (or
# production.py) via django-environ. Ones with no default there are
# REQUIRED and the process will refuse to start without them; the rest are
# optional overrides and are marked as such.

# --- Django (SECRET_KEY is required — startup fails if it is unset, rather
# --- than silently booting with a guessable key) ---
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Render provides this automatically for the web service when
# the Postgres service is attached; for local dev point at your own DB).
# Required.
#
# NOTE for a fresh local checkout: as well as `migrate`, run
# `python manage.py createcachetable` once. The database-backed cache is
# where API rate-limit counters live (see CACHES in config/settings/base.py),
# and the first throttled request errors if its table is missing.
DATABASE_URL=postgres://user:password@localhost:5432/nextwise_dev

# Resend (django-anymail). RESEND_API_KEY is only actually used by
# production.py — local dev prints emails to the runserver console instead,
# so it can be left blank here.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@nextwiseeducation.com

# Stripe (Phase 2 — placeholder, webhook endpoint is stubbed and unused in Phase 1)
STRIPE_WEBHOOK_SECRET=

# Used to build links in verification/password-reset emails. Also the
# default value of CORS_ALLOWED_ORIGINS below when that is not set
# separately.
FRONTEND_URL=http://localhost:5173

# --- Optional overrides (all have working defaults in settings) ---

# Which browser origins may call this API cross-origin. Defaults to just
# FRONTEND_URL. Set explicitly when more than one origin must be trusted at
# once — e.g. an apex domain and its www. subdomain, or a custom domain and
# the original *.onrender.com URL during a DNS cutover.
# CORS_ALLOWED_ORIGINS=https://nextwiseeducation.com,https://www.nextwiseeducation.com

# Logging verbosity. Defaults to INFO for both. Render captures the
# service's stdout as its logs, so these control what shows up there.
# LOG_LEVEL=INFO
# DJANGO_LOG_LEVEL=INFO

# HSTS max-age in seconds (production.py only). Defaults to one year.
# Lower it temporarily if a certificate problem ever makes HTTPS
# unavailable, since browsers otherwise refuse to fall back to HTTP.
# SECURE_HSTS_SECONDS=31536000

# One-off admin bootstrap, read by the `ensure_superuser` management
# command (Render's free plan has no shell access, so `createsuperuser`
# cannot be run interactively after deploy). Not needed locally, where
# `createsuperuser` works normally.
#
# SECURITY: on Render, clear DJANGO_SUPERUSER_PASSWORD from the dashboard
# once the first deploy has created the account — the command no-ops
# afterwards, so leaving it set only keeps a live admin password sitting in
# the service environment.
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
