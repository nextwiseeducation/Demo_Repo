# Copy to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Render provides this automatically for the web service when
# the Postgres service is attached; for local dev point at your own DB)
DATABASE_URL=postgres://user:password@localhost:5432/nextwise_dev

# Resend (django-anymail)
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@nextwiseeducation.com

# Stripe (Phase 2 — placeholder, webhook endpoint is stubbed and unused in Phase 1)
STRIPE_WEBHOOK_SECRET=

# Used to build links in verification/password-reset emails
FRONTEND_URL=http://localhost:5173
